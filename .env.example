# ── UI Login ───────────────────────────────────────────────────────────────
LOGIN_USER=<login-username>
LOGIN_PASSWORD=<login-password>

# ── LG Leads API (existing lg-leads-cdk stack) ────────────────────────────────
# Base URL already ends in /lg, e.g. https://<api-id>.execute-api.us-east-1.amazonaws.com/prod/lg
# (see Demos/LG/cdk/.env → API_BASE_URL)
LG_API_URL=<your-lg-api-base-url>
# Bearer token expected by the Lambdas (see Demos/LG/cdk/.env → BEARER_TOKEN)
LG_BEARER_TOKEN=<your-bearer-token>

# ── Email (chat-bot invite sent to Score = 0 leads with an active email) ─────
# Any SMTP provider works (e.g. Gmail app password, SendGrid, SES SMTP creds).
# Leave blank to skip sending — the upload will still succeed, just without emails.
SMTP_HOST=<your-smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<your-smtp-username>
SMTP_PASS=<your-smtp-password>
EMAIL_FROM=<from-address@example.com>
EMAIL_FROM_NAME=LG Lead Qualification
# Base URL used to build the chat-bot link in the email, e.g. https://lg-render-deploy.onrender.com
# Leave blank to auto-detect from the incoming request's host.
PUBLIC_BASE_URL=

# ── Chat widget (V2 bot embed shown at GET /chat) ─────────────────────────────
# Defaults already match the provided embed script — only override if it changes.
CHAT_WIDGET_SRC=https://flow-designer.demo.vnext.ixhello.com/chat-widget/assets/chat-widget.js
CHAT_WIDGET_ORG_ID=0343c5c3-fd2c-493c-a664-444a95c0f78a
CHAT_WIDGET_ID=6d69ddd6-9f36-4f5d-9927-6777d239f2bb
CHAT_WIDGET_FLOW_ID=bf0a4773-1eec-4547-a954-3bcefa48c777

# ── Server ────────────────────────────────────────────────────────────────────
# PORT is set automatically by Render — do not set here
NODE_ENV=production
